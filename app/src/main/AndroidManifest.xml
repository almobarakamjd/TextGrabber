<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- صلاحية إظهار الإشعارات (مطلوبة من Android 13 فأعلى) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- صلاحيات التحديث الذاتي: الاتصال بالإنترنت للتحقق من وجود إصدار
         جديد على GitHub، وتثبيت ملف APK المُنزَّل مباشرة داخل التطبيق. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TextGrabber">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TextGrabber">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            خدمة إمكانية الوصول (Accessibility Service):
            - BIND_ACCESSIBILITY_SERVICE: صلاحية إلزامية من النظام لأي خدمة من هذا النوع،
              تضمن أن النظام فقط هو من يستطيع ربط (bind) هذه الخدمة.
            - exported=true مع هذه الصلاحية آمن لأن النظام هو المتحكم بالربط.
        -->
        <service
            android:name=".service.MyAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            بلاطة الإعدادات السريعة (Quick Settings Tile) لتشغيل/إيقاف
            الزر العائم مباشرة دون فتح التطبيق. يضيفها المستخدم يدويا
            من "تعديل" في لوحة الإعدادات السريعة.
        -->
        <service
            android:name=".service.FloatingButtonTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
