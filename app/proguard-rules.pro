# قواعد ProGuard/R8 إضافية (لا نحتاج قواعد خاصة حالياً)

# ---------------------------------------------------------------------
# Tesseract4Android: الكود الأصلي (JNI) يبحث عن هذه الأصناف وحقولها
# بالاسم أثناء التشغيل (خصوصا الحقل mNativeData ودوال رد النداء). لا
# توفّر المكتبة قواعد consumer خاصة بها، فبدون هذه القواعد يعيد R8
# تسميتها في نسخة الإصدار فينهار التطبيق عند أول استخدام لـOCR — بينما
# تعمل نسخة التصحيح بلا مشكلة لأن التصغير معطّل فيها.
# ---------------------------------------------------------------------
-keep class com.googlecode.tesseract.android.** { *; }
-keep class com.googlecode.leptonica.android.** { *; }
-keepclasseswithmembernames class * {
    native <methods>;
}
